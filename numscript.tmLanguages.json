{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Numscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#feature" },
    { "include": "#functions" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#constant" },
    { "include": "#entity" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.numscript",
          "match": "//.*$"
        },
        { "include": "#block_comment" }
      ]
    },
    "block_comment": {
      "name": "comment.block.numscript",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [{ "include": "#block_comment" }]
    },
    "feature": {
      "name": "meta.preprocessor.feature.numscript",
      "begin": "#!",
      "end": "(?<=\\])|$",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.preprocessor.numscript" }
      },
      "patterns": [
        {
          "name": "keyword.other.feature.numscript",
          "match": "\\bfeature\\b"
        },
        { "include": "#strings" }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.numscript",
          "match": "\\b(set_tx_meta|set_account_meta|meta|balance|overdraft|get_asset|get_amount|scoped)\\b(?=\\s*\\()"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.numscript",
          "match": "\\b(vars|send|save|source|destination|to|from|max|remaining|oneof|through)\\b"
        },
        {
          "name": "keyword.other.numscript",
          "match": "\\b(allowing|unbounded|overdraft|up|kept|with|scaling)\\b"
        },
        {
          "name": "keyword.operator.restrict.numscript",
          "match": "\\\\"
        },
        {
          "name": "keyword.operator.arithmetic.numscript",
          "match": "[+\\-/*]"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.numscript",
          "match": "\\b(monetary|account|portion|asset|number|string)\\b(?=\\s+\\$)"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.numscript",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.numscript",
          "match": "\\\\."
        }
      ]
    },
    "constant": {
      "patterns": [
        { "include": "#percentage" },
        { "include": "#number" },
        {
          "name": "constant.language.asset.numscript",
          "match": "\\b[A-Z][A-Z0-9]*(?:/[0-9]+)?\\b"
        }
      ]
    },
    "percentage": {
      "name": "constant.numeric.percentage.numscript",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?%"
    },
    "number": {
      "name": "constant.numeric.numscript",
      "match": "\\b[0-9]+(?:_[0-9]+)*\\b"
    },
    "entity": {
      "patterns": [
        {
          "name": "variable.other.numscript",
          "match": "\\$[a-z_][a-z0-9_]*"
        },
        {
          "name": "entity.name.namespace.account.numscript",
          "match": "@(?:[A-Za-z0-9_-]+|\\$[a-z_][a-z0-9_]*)(?::(?:[A-Za-z0-9_-]+|\\$[a-z_][a-z0-9_]*))*"
        }
      ]
    }
  },
  "scopeName": "source.numscript"
}
