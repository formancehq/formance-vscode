{
  "send": {
    "prefix": ["send"],
    "body": [
      "send ${1:[USD/2 100]} (",
      "  source = $2",
      "  destination = $3",
      ")"
    ],
    "description": "send statement"
  },
  "save": {
    "prefix": ["save"],
    "body": ["save ${1:[USD/2 100]} from $2"],
    "description": "save statement"
  },
  "vars": {
    "prefix": ["vars"],
    "body": ["vars {", "  ${1:monetary} \\$$2", "}", ""],
    "description": "variable declarations"
  },
  "set_tx_meta": {
    "prefix": ["set_tx_meta"],
    "body": ["set_tx_meta(\"${1:key}\", $2)"],
    "description": "set transaction metadata"
  },
  "set_account_meta": {
    "prefix": ["set_account_meta"],
    "body": ["set_account_meta(@${1:account}, \"${2:key}\", $3)"],
    "description": "set account metadata"
  }
}
